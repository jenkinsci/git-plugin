<!--
  Displays the Git change log digest for the build top page 
  when a build history link (or number) is followed
  e.g https://<jenkins_url>/job/<project>/<build number>/
  
  NOTE: For multi-repository builds, changes are displayed under each 
  repository section in BuildData/summary.jelly instead of here to avoid duplication.
-->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
  <!-- Don't render anything here for multi-repository builds -->
  <!-- Changes are shown grouped by repository in the BuildData sections above -->
</j:jelly>
