<?jelly escape-by-default='true'?>
<!--
  Displays Git change log.
-->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form" xmlns:i="jelly:fmt">
  <j:set var="browser" value="${it.browser}"/>

  <st:adjunct includes="hudson.plugins.git.styles" />

  <j:set var="showBoth" value="${it.showAuthorAndCommitter}" />

  <div class="git-changeset-container">
    <j:forEach var="cs" items="${it.logs}">
      <div class="git-changeset ${compact ? 'git-changeset--compact' : ''}" id="${cs.id}">
        <j:set var="cslink" value="${browser.getChangeSetLink(cs)}"/>

        <j:if test="${cslink != null}">
          <a href="${cslink}" class="git-changeset__items__item__message" target="_blank">
            <l:icon src="symbol-git-commit-outline plugin-ionicons-api" />
            <span>${cs.msg}</span>
            <div class="git-changeset__items__item__hash">
              <span class="jenkins-visually-hidden">(</span>
              ${cs.id.substring(0, 7)}
              <span class="jenkins-visually-hidden">)</span>
            </div>
          </a>
        </j:if>
        <j:if test="${cslink == null}">
          <div class="git-changeset__items__item__message">
            <l:icon src="symbol-git-commit-outline plugin-ionicons-api" />
            <j:out value="${cs.commentAnnotated}"/>
          </div>
        </j:if>
        <j:if test="${!compact and !empty(cs.paths)}">
          <div class="git-changeset__items__item__files">
            <j:forEach var="p" items="${cs.paths}">
              <a href="${browser.getFileLink(p)}" target="_blank">
                <l:icon src="symbol-document-outline plugin-ionicons-api" />
                ${p.path}
              </a>
            </j:forEach>
          </div>
        </j:if>
        <div class="git-changeset__items__item__user">
          <j:choose>
            <j:when test="${showBoth and !compact and cs.gitAuthorName != null and cs.gitCommitterName != null and cs.gitAuthorName ne cs.gitCommitterName}">
              <a href="${rootURL}/${cs.author.url}/">
                <l:icon src="${h.getUserAvatar(cs.author, '64x64')}" class="jenkins-avatar" />
                <span class="jenkins-visually-hidden">${cs.author.displayName}</span>
              </a>
              <span class="git-changeset__items__item__identities">
                <span>${%authored_by(cs.gitAuthorName)}</span>
                <span aria-hidden="true">&#xB7;</span>
                <span>${%committed_by(cs.gitCommitterName)}</span>
              </span>
            </j:when>
            <j:otherwise>
              <a href="${rootURL}/${cs.author.url}/">
                <l:icon src="${h.getUserAvatar(cs.author, '64x64')}" class="jenkins-avatar" />
                ${cs.author.displayName}
              </a>
            </j:otherwise>
          </j:choose>
          ${%at}
          <j:new var="timestamp" className="java.util.Date">
            <j:arg value="${cs.timestamp}" />
          </j:new>
          <time datetime="${h.iso8601DateTime(timestamp)}">
            <i:formatDate value="${timestamp}" type="time" timeStyle="short" />
            <st:nbsp />
            <i:formatDate value="${timestamp}" type="date" dateStyle="short" />
          </time>
        </div>
      </div>
    </j:forEach>
  </div>
</j:jelly>
